# Same project URL as the desktop app
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The SECRET (service_role) key — NOT the publishable one. Inserts bypass RLS.
# Never used by the desktop app; never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
# --- Optional job sources. Each is skipped if its keys are missing. ---
# Remotive (remote-only listings) needs no key and is always on.

# USAJobs — free, instant signup at developer.usajobs.gov. Federal jobs,
# real location search, lots of IT support / help desk roles.
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Adzuna — free tier at developer.adzuna.com. Aggregates many boards with
# true location + radius search.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch via RapidAPI (Indeed/LinkedIn/Glassdoor).
RAPIDAPI_KEY=
