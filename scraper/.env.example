# Same project URL as the desktop app
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The SECRET (service_role) key — NOT the publishable one. Inserts bypass RLS.
# Never used by the desktop app; never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
# Optional: RapidAPI key for JSearch (Indeed/LinkedIn/Glassdoor coverage).
# Leave unset to skip that source entirely.
RAPIDAPI_KEY=
# Optional: Anthropic API key (console.anthropic.com) for AI fit scoring of
# new listings against your profile_chunks. Leave unset to skip scoring.
ANTHROPIC_API_KEY=
